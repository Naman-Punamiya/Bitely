@{
    ViewData["Title"] = "Access Denied";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="app-card text-center p-5 shadow-sm">
            <div class="text-danger fs-1 mb-3">
                <i class="bi bi-shield-x"></i>
            </div>
            <h3 class="fw-bold mb-2">Access Denied</h3>
            <p class="text-muted mb-4">
                You do not have permission to access this page. This resource is restricted to specific user roles.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house me-1"></i> Back to Home
                </a>
                <a asp-controller="FoodStall" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-grid me-1"></i> Food Stalls
                </a>
            </div>
        </div>
    </div>
</div>
