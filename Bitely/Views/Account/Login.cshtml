@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="app-card shadow-sm">
            <div class="app-card-header text-center py-4">
                <div class="text-primary fs-1 mb-2">
                    <i class="bi bi-box-arrow-in-right"></i>
                </div>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <p class="text-muted small mb-0">Sign in to your Bitely account</p>
            </div>
            
            <div class="app-card-body p-4">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-4" style="display: @(ViewData.ModelState.IsValid ? "none" : "block");"></div>

                <!-- Quick Test Login Buttons -->
                <div class="p-3 mb-4 bg-light rounded border">
                    <span class="text-muted small fw-semibold d-block mb-2 text-center">
                        <i class="bi bi-key me-1"></i> Quick Test Credentials:
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-primary flex-fill" onclick="fillCredentials('cust@mail.com', 'cust123')">
                            <i class="bi bi-person me-1"></i> Customer
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" onclick="fillCredentials('shop@mail.com', 'shop123')">
                            <i class="bi bi-shop me-1"></i> Shopkeeper
                        </button>
                    </div>
                </div>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </div>
                </form>
            </div>

            <div class="app-card-footer text-center py-3">
                <p class="text-muted small mb-0">
                    Don't have an account? 
                    <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-primary fw-semibold text-decoration-none">
                        Register here
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, password) {
            var emailInput = document.getElementById('Email') || document.querySelector('input[name="Email"]');
            var passwordInput = document.getElementById('Password') || document.querySelector('input[name="Password"]');
            if (emailInput && passwordInput) {
                emailInput.value = email;
                passwordInput.value = password;
                emailInput.focus();
            }
        }
    </script>
}
