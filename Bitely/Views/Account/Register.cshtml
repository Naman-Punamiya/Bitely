@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<div asp-validation-summary="All"></div>

<form asp-action="Register" method="post">
    <div>
        <label asp-for="Name">Name:</label><br />
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <br />
    <div>
        <label asp-for="Email">Email:</label><br />
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <br />
    <div>
        <label asp-for="Password">Password:</label><br />
        <input asp-for="Password" />
        <span asp-validation-for="Password"></span>
    </div>
    <br />
    <div>
        <label asp-for="ConfirmPassword">Confirm Password:</label><br />
        <input asp-for="ConfirmPassword" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
    <br />
    <div>
        <label asp-for="Role">Role:</label><br />
        <select asp-for="Role">
            <option value="">-- Select Role --</option>
            <option value="Consumer">Consumer</option>
            <option value="FoodStallOwner">Food Stall Owner</option>
        </select>
        <span asp-validation-for="Role"></span>
    </div>
    <br />
    <button type="submit">Register</button>
</form>

<p><a asp-action="Login">Already have an account? Login</a></p>
