@{
    ViewData["Title"] = "Home";
}

<h1>Welcome to Bitely</h1>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div>
        <h3>Welcome, @User.Identity.Name!</h3>
        <p>Your Role: <strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong></p>

        @if (User.IsInRole("Consumer"))
        {
            <p>You are logged in as a <strong>Consumer</strong>.</p>
        }
        else if (User.IsInRole("FoodStallOwner"))
        {
            <p>You are logged in as a <strong>Food Stall Owner</strong>.</p>
        }

        <br />
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit">Logout</button>
        </form>
    </div>
}
else
{
    <div>
        <p>You are not logged in.</p>
        <p>
            <a asp-controller="Account" asp-action="Login">Login</a> | 
            <a asp-controller="Account" asp-action="Register">Register</a>
        </p>
    </div>
}
