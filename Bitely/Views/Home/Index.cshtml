@using System.Security.Claims
@{
    ViewData["Title"] = "Home";
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value;
    var isOwner = userRole == Bitely.Models.Roles.FoodStallOwner;
    var isConsumer = userRole == Bitely.Models.Roles.Consumer;
}

<div class="row align-items-center mb-5">
    <div class="col-lg-8">
        <h1 class="display-5 fw-bold text-dark mb-2">Welcome to Bitely</h1>
        <p class="lead text-muted mb-0">Smart Food Court & Vendor Queue Management System</p>
    </div>
    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <a asp-controller="FoodStall" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="bi bi-shop me-1"></i> Browse Food Stalls
        </a>
    </div>
</div>

@if (isAuthenticated)
{
    <div class="app-card mb-4 p-4 border-start border-4 border-primary">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h4 class="fw-bold mb-1">Hello, @User.Identity?.Name!</h4>
                <p class="text-muted mb-0">
                    You are logged in as a 
                    <span class="badge-role ms-1">
                        <i class="bi bi-person-badge me-1"></i>@(isOwner ? "Food Stall Owner" : "Consumer")
                    </span>
                </p>
            </div>
            <div>
                @if (isOwner)
                {
                    <a asp-controller="FoodStall" asp-action="Create" class="btn btn-outline-primary me-2">
                        <i class="bi bi-plus-circle me-1"></i> Create New Stall
                    </a>
                }
                <a asp-controller="FoodStall" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-grid me-1"></i> View All Stalls
                </a>
            </div>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="app-card app-card-hover h-100 p-4">
            <div class="text-primary fs-2 mb-3">
                <i class="bi bi-shop-window"></i>
            </div>
            <h5 class="fw-bold mb-2">Food Outlets</h5>
            <p class="text-muted mb-3">Explore open food stalls in the food court, browse vendor locations, and view stall availability.</p>
            <a asp-controller="FoodStall" asp-action="Index" class="btn btn-sm btn-outline-primary mt-auto">
                Explore Stalls <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="app-card app-card-hover h-100 p-4">
            <div class="text-primary fs-2 mb-3">
                <i class="bi bi-card-checklist"></i>
            </div>
            <h5 class="fw-bold mb-2">Digital Menus</h5>
            <p class="text-muted mb-3">Check out delicious dishes, meal prices, category filters, and item availability in real time.</p>
            <a asp-controller="FoodStall" asp-action="Index" class="btn btn-sm btn-outline-primary mt-auto">
                View Menus <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="app-card app-card-hover h-100 p-4">
            <div class="text-primary fs-2 mb-3">
                <i class="bi bi-person-lock"></i>
            </div>
            <h5 class="fw-bold mb-2">Role-Based Access</h5>
            <p class="text-muted mb-3">Seamless role authorization for Consumers and Food Stall Owners powered by ASP.NET Core Identity.</p>
            @if (!isAuthenticated)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-outline-primary mt-auto">
                    Get Started <i class="bi bi-arrow-right ms-1"></i>
                </a>
            }
            else
            {
                <span class="text-success fw-semibold small mt-auto"><i class="bi bi-check-circle me-1"></i> Authenticated</span>
            }
        </div>
    </div>
</div>
