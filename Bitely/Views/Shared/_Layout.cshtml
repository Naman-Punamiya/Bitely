@using System.Security.Claims
@inject Bitely.Data.ApplicationDbContext DbContext
@{
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int unreadNotificationsCount = 0;
    int cartItemCount = 0;
    string displayName = User.Identity?.Name ?? "User";
    string userEmail = "";
    var isOwner = User.IsInRole(Bitely.Models.Roles.FoodStallOwner);
    var isConsumer = User.IsInRole(Bitely.Models.Roles.Consumer);

    if (User.Identity != null && User.Identity.IsAuthenticated && !string.IsNullOrEmpty(currentUserId))
    {
        unreadNotificationsCount = DbContext.Notifications.Count(n => n.UserId == currentUserId && !n.IsRead);
        cartItemCount = DbContext.Carts.Where(c => c.CustomerId == currentUserId).SelectMany(c => c.CartItems).Sum(ci => (int?)ci.Quantity) ?? 0;
        var userObj = DbContext.Users.Find(currentUserId);
        if (userObj != null)
        {
            displayName = !string.IsNullOrWhiteSpace(userObj.Name) ? userObj.Name : (userObj.UserName ?? "User");
            userEmail = userObj.Email ?? "";
        }
    }
    var initial = !string.IsNullOrEmpty(displayName) ? displayName.Substring(0, 1).ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bitely</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar sticky-top">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand me-3 me-lg-4" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="bi bi-shop"></i>
                    </div>
                    <span class="brand-name">Bitely</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0 shadow-none px-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <!-- Navbar Links and Actions -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Main Navigation Links (Left) -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav-main-links gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="FoodStall" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Food Stalls
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Menu" asp-action="Index">
                                <i class="bi bi-card-checklist me-1"></i> Digital Menus
                            </a>
                        </li>

                        @if (isOwner)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Order" asp-action="StallOrders">
                                    <i class="bi bi-receipt me-1"></i> Stall Orders
                                </a>
                            </li>
                        }
                        @if (isConsumer)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-controller="Order" asp-action="Index">
                                    <i class="bi bi-bag-check me-1"></i> My Orders
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Right Action Bar & User Profile -->
                    <div class="d-flex align-items-lg-center flex-column flex-lg-row gap-2 gap-lg-3 pt-2 pt-lg-0 border-top border-lg-0 mt-2 mt-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Shopkeeper Primary Action: Add Stall CTA -->
                            @if (isOwner)
                            {
                                <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1 rounded-pill px-3 fw-medium" asp-controller="FoodStall" asp-action="Create">
                                    <i class="bi bi-plus-lg"></i>
                                    <span>Add Stall</span>
                                </a>
                            }

                            <!-- Consumer Cart Button with Badge -->
                            @if (isConsumer)
                            {
                                <a class="nav-icon-btn position-relative" asp-controller="Cart" asp-action="Index" title="View Cart">
                                    <i class="bi bi-cart3"></i>
                                    @if (cartItemCount > 0)
                                    {
                                        <span class="nav-badge-count">@(cartItemCount > 99 ? "99+" : cartItemCount.ToString())</span>
                                    }
                                </a>
                            }

                            <!-- Notifications Button with Badge -->
                            <a class="nav-icon-btn position-relative" asp-controller="Notification" asp-action="Index" title="Notifications">
                                <i class="bi bi-bell"></i>
                                @if (unreadNotificationsCount > 0)
                                {
                                    <span class="nav-badge-count">@(unreadNotificationsCount > 99 ? "99+" : unreadNotificationsCount.ToString())</span>
                                }
                            </a>

                            <!-- User Profile Dropdown -->
                            <div class="dropdown">
                                <button class="user-profile-btn dropdown-toggle d-flex align-items-center gap-2 border-0 bg-transparent p-1" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar-circle">
                                        @initial
                                    </div>
                                    <div class="text-start d-none d-lg-inline-block line-height-tight">
                                        <div class="user-name-text">@displayName</div>
                                        <span class="user-role-badge">@(isOwner ? "Stall Owner" : "Customer")</span>
                                    </div>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow-sm border mt-2 py-2" aria-labelledby="userMenuButton">
                                    <li class="px-3 py-2 border-bottom mb-1">
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">@displayName</div>
                                        @if (!string.IsNullOrEmpty(userEmail))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 200px;">@userEmail</div>
                                        }
                                        <span class="badge @(isOwner ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-success-subtle text-success border border-success-subtle") mt-1 small">
                                            @(isOwner ? "Food Stall Owner" : "Consumer")
                                        </span>
                                    </li>

                                    @if (isOwner)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="FoodStall" asp-action="Index">
                                                <i class="bi bi-shop text-primary"></i> My Food Stalls
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Order" asp-action="StallOrders">
                                                <i class="bi bi-receipt text-primary"></i> Manage Orders
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="FoodStall" asp-action="Create">
                                                <i class="bi bi-plus-circle text-primary"></i> Add New Stall
                                            </a>
                                        </li>
                                    }
                                    @if (isConsumer)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Order" asp-action="Index">
                                                <i class="bi bi-bag-check text-primary"></i> My Orders
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Cart" asp-action="Index">
                                                <i class="bi bi-cart3 text-primary"></i> My Cart (@cartItemCount)
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Notification" asp-action="Index">
                                            <i class="bi bi-bell text-primary"></i> Notifications
                                            @if (unreadNotificationsCount > 0)
                                            {
                                                <span class="badge bg-danger rounded-pill ms-auto">@unreadNotificationsCount</span>
                                            }
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Guest Auth Buttons -->
                            <div class="d-flex align-items-center gap-2">
                                <a class="btn btn-sm btn-outline-primary px-3 rounded-pill fw-medium" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                                <a class="btn btn-sm btn-primary px-3 rounded-pill fw-medium" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-container">
        <main role="main" class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 <strong>Bitely</strong> - Food Court Queue & Menu Management</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
