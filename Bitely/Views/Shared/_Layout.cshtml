@using System.Security.Claims
@inject Bitely.Data.ApplicationDbContext DbContext
@{
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    int unreadNotificationsCount = 0;
    int cartItemCount = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated && !string.IsNullOrEmpty(currentUserId))
    {
        unreadNotificationsCount = DbContext.Notifications.Count(n => n.UserId == currentUserId && !n.IsRead);
        cartItemCount = DbContext.Carts.Where(c => c.CustomerId == currentUserId).SelectMany(c => c.CartItems).Sum(ci => (int?)ci.Quantity) ?? 0;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bitely</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop text-primary"></i>
                    <span>Bitely</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="FoodStall" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Food Stalls
                            </a>
                        </li>
                        @if (User.IsInRole(Bitely.Models.Roles.FoodStallOwner))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Order" asp-action="StallOrders">
                                    <i class="bi bi-receipt me-1"></i> Stall Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link position-relative" asp-controller="Notification" asp-action="Index">
                                    <i class="bi bi-bell me-1"></i> Notifications
                                    @if (unreadNotificationsCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill ms-1">@unreadNotificationsCount</span>
                                    }
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-semibold" asp-controller="FoodStall" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i> Add Stall
                                </a>
                            </li>
                        }
                        @if (User.IsInRole(Bitely.Models.Roles.Consumer))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Order" asp-action="Index">
                                    <i class="bi bi-bag-check me-1"></i> My Orders
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link position-relative" asp-controller="Notification" asp-action="Index">
                                    <i class="bi bi-bell me-1"></i> Notifications
                                    @if (unreadNotificationsCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill ms-1">@unreadNotificationsCount</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirst(ClaimTypes.Role)?.Value;
                            var roleDisplay = role == Bitely.Models.Roles.FoodStallOwner ? "Owner" : "Consumer";
                            
                            @if (User.IsInRole(Bitely.Models.Roles.Consumer))
                            {
                                <li class="nav-item me-lg-2">
                                    <a class="btn btn-sm btn-outline-primary position-relative" asp-controller="Cart" asp-action="Index">
                                        <i class="bi bi-cart3 me-1"></i> Cart
                                        @if (cartItemCount > 0)
                                        {
                                            <span class="badge bg-primary text-white rounded-pill ms-1">@cartItemCount</span>
                                        }
                                    </a>
                                </li>
                            }

                            <li class="nav-item d-flex align-items-center me-lg-2">
                                <span class="badge-role me-2">
                                    <i class="bi bi-person-badge me-1"></i>@roleDisplay
                                </span>
                                <span class="fw-semibold text-dark">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-container">
        <main role="main" class="container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-4 shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 <strong>Bitely</strong> - Food Court Queue & Menu Management</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
