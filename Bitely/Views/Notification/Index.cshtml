@model IEnumerable<Bitely.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
            <div>
                <h2 class="fw-bold mb-1"><i class="bi bi-bell text-primary me-2"></i>Notifications</h2>
                <p class="text-muted mb-0">Stay updated on orders, status updates, and stall activity</p>
            </div>

            @if (unreadCount > 0)
            {
                <form asp-action="MarkAllAsRead" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-check2-all me-1"></i> Mark All as Read
                    </button>
                </form>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state py-5 shadow-sm text-center">
                <div class="empty-state-icon fs-1 text-muted mb-2">
                    <i class="bi bi-bell-slash"></i>
                </div>
                <h5 class="empty-state-title">No Notifications</h5>
                <p class="empty-state-text small text-muted mb-3">
                    You're all caught up! When orders or status changes occur, you will be notified here.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-house me-1"></i> Back to Home
                </a>
            </div>
        }
        else
        {
            <div class="app-card border bg-white rounded-3 shadow-sm overflow-hidden">
                <div class="list-group list-group-flush">
                    @foreach (var notification in Model)
                    {
                        var isUnread = !notification.IsRead;
                        <div class="list-group-item p-3 @(isUnread ? "bg-primary-subtle bg-opacity-25" : "")">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="text-primary fs-4 mt-1">
                                        @if (isUnread)
                                        {
                                            <i class="bi bi-bell-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-bell text-muted"></i>
                                        }
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <h6 class="fw-bold mb-0 text-dark">@notification.Title</h6>
                                            @if (isUnread)
                                            {
                                                <span class="badge bg-warning text-dark small py-0 px-2">New</span>
                                            }
                                        </div>
                                        <p class="text-secondary small mb-2">@notification.Message</p>
                                        <div class="d-flex align-items-center gap-3 text-muted small">
                                            <span><i class="bi bi-clock me-1"></i>@notification.CreatedAt.ToLocalTime().ToString("MMM dd, h:mm tt")</span>
                                            @if (notification.OrderId.HasValue)
                                            {
                                                <a asp-controller="Order" asp-action="Details" asp-route-id="@notification.OrderId.Value" class="text-primary fw-semibold text-decoration-none">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i> View Order
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @if (isUnread)
                                {
                                    <form asp-action="MarkAsRead" method="post">
                                        <input type="hidden" name="id" value="@notification.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Mark as Read">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
