@model IEnumerable<Bitely.Models.MenuItem>
@using System.Security.Claims

@{
    var foodStall = ViewBag.FoodStall as Bitely.Models.FoodStall;
    ViewData["Title"] = $"Menu - {foodStall?.Name ?? "Food Stall"}";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isMyStall = foodStall != null && currentUserId != null && foodStall.OwnerId == currentUserId;
    var isOwnerRole = User.IsInRole(Bitely.Models.Roles.FoodStallOwner);
}

<div class="mb-4">
    <a asp-controller="FoodStall" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Food Stalls
    </a>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-book text-primary me-2"></i>Menu for @(foodStall?.Name ?? "Food Stall")
            </h2>
            <p class="text-muted mb-0">
                <i class="bi bi-geo-alt me-1"></i> @(foodStall?.Location ?? "Food Court") &nbsp;|&nbsp;
                @if (foodStall != null && foodStall.IsOpen)
                {
                    <span class="text-success fw-semibold"><i class="bi bi-circle-fill fs-6 me-1"></i> Open</span>
                }
                else
                {
                    <span class="text-danger fw-semibold"><i class="bi bi-circle-fill fs-6 me-1"></i> Closed</span>
                }
            </p>
        </div>

        @if (isOwnerRole && isMyStall && foodStall != null)
        {
            <a asp-action="Create" asp-route-foodStallId="@foodStall.Id" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add Menu Item
            </a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <i class="bi bi-card-list"></i>
        </div>
        <div class="empty-state-title">No Menu Items Listed</div>
        <div class="empty-state-text">
            There are currently no dishes or drinks available on this menu.
        </div>
        @if (isOwnerRole && isMyStall && foodStall != null)
        {
            <a asp-action="Create" asp-route-foodStallId="@foodStall.Id" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Add First Item
            </a>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="app-card app-card-hover h-100 d-flex flex-column">
                    <div class="app-card-body flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@item.Name</h5>
                            <span class="fw-bold fs-5 text-primary">₹@item.Price.ToString("F2")</span>
                        </div>

                        <div class="mb-3">
                            <span class="badge-category me-2">@item.Category</span>
                            @if (item.IsAvailable)
                            {
                                <span class="badge-open small">
                                    <i class="bi bi-check-circle me-1"></i> Available
                                </span>
                            }
                            else
                            {
                                <span class="badge-closed small">
                                    <i class="bi bi-x-circle me-1"></i> Unavailable
                                </span>
                            }
                        </div>

                        <p class="text-secondary small mb-0">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                        </p>
                    </div>

                    <div class="app-card-footer d-flex justify-content-between align-items-center gap-2">
                        @if (isOwnerRole && isMyStall)
                        {
                            <span class="small text-muted">Owner options</span>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </a>
                            </div>
                        }
                        else
                        {
                            @if (foodStall != null && foodStall.IsOpen && item.IsAvailable)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex align-items-center gap-2 ms-auto">
                                    <input type="hidden" name="menuItemId" value="@item.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <input type="number" name="quantity" value="1" min="1" max="20" class="form-control form-control-sm text-center" style="width: 60px;" />
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border ms-auto">
                                    <i class="bi bi-slash-circle me-1"></i> Not Available to Order
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
