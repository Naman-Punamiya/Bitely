@model IEnumerable<Bitely.Models.MenuItem>
@using System.Security.Claims

@{
    ViewData["Title"] = "Menu Items";
    var foodStall = ViewBag.FoodStall as Bitely.Models.FoodStall;
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isMyStall = foodStall != null && currentUserId != null && foodStall.OwnerId.ToString() == currentUserId;
    var isOwnerRole = User.IsInRole(Bitely.Models.Roles.FoodStallOwner);
    var isConsumerRole = User.IsInRole(Bitely.Models.Roles.Consumer);
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
}

<h2>Menu for @(foodStall?.Name ?? "Food Stall")</h2>

@if (isOwnerRole && isMyStall && foodStall != null)
{
    <p>
        <a asp-action="Create" asp-route-foodStallId="@foodStall.Id">Add New Menu Item</a>
    </p>
}

<table border="1" cellpadding="8" cellspacing="0">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Category</th>
            <th>Price</th>
            <th>Available</th>
            @if (isOwnerRole && isMyStall)
            {
                <th>Owner Actions</th>
            }
            @if (isConsumerRole || !isAuthenticated)
            {
                <th>Action</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Category</td>
                <td>@item.Price.ToString("C")</td>
                <td>@(item.IsAvailable ? "Yes" : "No")</td>
                @if (isOwnerRole && isMyStall)
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                }
                @if (isConsumerRole || !isAuthenticated)
                {
                    <td>
                        @if (item.IsAvailable)
                        {
                            <form asp-controller="Cart" asp-action="AddItem" method="post" style="display:inline-flex; gap:5px;">
                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                <input type="number" name="quantity" value="1" min="1" style="width: 50px;" />
                                <button type="submit">Add to Cart</button>
                            </form>
                        }
                        else
                        {
                            <span>Unavailable</span>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<br />
<p>
    <a asp-controller="FoodStall" asp-action="Index">Back to Food Stalls</a> | 
    <a asp-controller="Cart" asp-action="Index">View Cart</a>
</p>
