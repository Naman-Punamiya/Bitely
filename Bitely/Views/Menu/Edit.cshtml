@model Bitely.Models.MenuItem

@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="app-card shadow-sm">
            <div class="app-card-header py-3">
                <h4 class="fw-bold mb-0">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Menu Item
                </h4>
            </div>

            <div class="app-card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FoodStallId" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Dish / Drink Name</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label">Category</label>
                            <input asp-for="Category" class="form-control" required />
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label">Price (₹)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">₹</span>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description / Ingredients</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsAvailable" class="form-check-input" type="checkbox" id="isAvailableSwitch" />
                        <label class="form-check-label fw-semibold" for="isAvailableSwitch">Available for ordering</label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" asp-route-foodStallId="@Model.FoodStallId" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
