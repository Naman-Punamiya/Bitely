@model Bitely.Models.MenuItem

@{
    ViewData["Title"] = "Add Menu Item";
    var foodStall = ViewBag.FoodStall as Bitely.Models.FoodStall;
}

<h2>Add Menu Item @(foodStall != null ? $"for {foodStall.Name}" : "")</h2>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="FoodStallId" />
    <div>
        <label asp-for="Name"></label><br />
        <input asp-for="Name" required />
        <span asp-validation-for="Name"></span>
    </div>
    <br />
    <div>
        <label asp-for="Description"></label><br />
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    <br />
    <div>
        <label asp-for="Category"></label><br />
        <input asp-for="Category" required />
        <span asp-validation-for="Category"></span>
    </div>
    <br />
    <div>
        <label asp-for="Price"></label><br />
        <input asp-for="Price" type="number" step="0.01" required />
        <span asp-validation-for="Price"></span>
    </div>
    <br />
    <div>
        <label>
            <input asp-for="IsAvailable" type="checkbox" /> Is Available
        </label>
    </div>
    <br />
    <button type="submit">Create</button>
    <a asp-action="Index" asp-route-foodStallId="@Model.FoodStallId">Cancel</a>
</form>
