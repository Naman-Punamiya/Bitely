@model Bitely.Models.QueueEntry

@{
    ViewData["Title"] = "Queue Status";
}

<h2>Queue Status - Order #@Model.OrderId</h2>

<div style="border: 2px solid #007bff; padding: 20px; max-width: 450px; background-color: #f8f9fa;">
    <h3>Food Stall: @(Model.Order?.FoodStall?.Name ?? Model.FoodStallId.ToString())</h3>
    
    <p><strong>Your Queue Number:</strong></p>
    <div style="font-size: 3em; font-weight: bold; color: #28a745; margin: 10px 0;">
        #@Model.QueueNumber
    </div>

    <p><strong>Status:</strong></p>
    <div id="live-status-display" style="font-size: 1.5em; font-weight: bold; color: #dc3545;">
        @Model.Status
    </div>

    <p style="margin-top: 15px; font-size: 0.9em; color: #6c757d;">
        <em>Status updates automatically in real-time via SignalR.</em>
    </p>
</div>

<br />
<p>
    <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.OrderId">View Order Details</a> | 
    <a asp-controller="Dashboard" asp-action="Index">Go to Dashboard</a>
</p>

<!-- SignalR Live Script -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    const targetOrderId = "@Model.OrderId";
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/queueHub")
        .build();

    connection.on("ReceiveStatusUpdate", function (orderId, newStatus) {
        if (orderId === targetOrderId) {
            const statusDisplay = document.getElementById("live-status-display");
            if (statusDisplay) {
                statusDisplay.innerText = newStatus;
            }
        }
    });

    connection.start().then(function () {
        connection.invoke("JoinOrderGroup", targetOrderId);
    }).catch(function (err) {
        console.error("SignalR Connection Error: ", err);
    });
</script>
