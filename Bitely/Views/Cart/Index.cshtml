@model Bitely.Models.Cart

@{
    ViewData["Title"] = "Your Shopping Cart";
    var hasItems = Model != null && Model.CartItems != null && Model.CartItems.Any();
    var grandTotal = hasItems ? Model!.CartItems!.Sum(ci => ci.UnitPrice * ci.Quantity) : 0m;
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cart3 text-primary me-2"></i>Shopping Cart</h2>
        <p class="text-muted mb-0">Review items in your cart and order in full</p>
    </div>
    @if (hasItems)
    {
        <form asp-controller="Cart" asp-action="ClearCart" method="post" onsubmit="return confirm('Are you sure you want to clear your entire cart?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash3 me-1"></i> Clear Cart
            </button>
        </form>
    }
</div>

@if (!hasItems)
{
    <div class="empty-state">
        <div class="empty-state-icon text-muted">
            <i class="bi bi-cart-x"></i>
        </div>
        <div class="empty-state-title">Your Cart is Empty</div>
        <div class="empty-state-text">
            Looks like you haven't added any delicious food or drinks to your cart yet.
        </div>
        <a asp-controller="FoodStall" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-shop me-1"></i> Explore Food Stalls
        </a>
    </div>
}
else
{
    var stallGroups = Model!.CartItems!
        .Where(ci => ci.MenuItem != null)
        .GroupBy(ci => ci.MenuItem!.FoodStall);

    <div class="row g-4">
        <div class="col-lg-8">
            @foreach (var group in stallGroups)
            {
                var stall = group.Key;
                var stallSubtotal = group.Sum(ci => ci.UnitPrice * ci.Quantity);

                <div class="app-card shadow-sm mb-4">
                    <div class="app-card-header bg-light d-flex justify-content-between align-items-center py-3">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-shop text-primary me-2"></i>@(stall?.Name ?? "Food Stall")
                            </h5>
                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@(stall?.Location ?? "Food Court")</small>
                        </div>
                        <span class="badge bg-light text-dark border">
                            @group.Count() item@(group.Count() > 1 ? "s" : "")
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-muted">
                                <tr>
                                    <th style="min-width: 180px;">Item</th>
                                    <th>Price</th>
                                    <th style="min-width: 140px;">Quantity</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    var itemSubtotal = item.UnitPrice * item.Quantity;
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@(item.MenuItem?.Name ?? "Menu Item")</div>
                                            <small class="badge-category">@(item.MenuItem?.Category ?? "General")</small>
                                        </td>
                                        <td>$@item.UnitPrice.ToString("F2")</td>
                                        <td>
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control form-control-sm text-center" style="width: 65px;" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Update Quantity">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            $@itemSubtotal.ToString("F2")
                                        </td>
                                        <td class="text-end">
                                            <form asp-controller="Cart" asp-action="RemoveItem" method="post" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 p-1" title="Remove Item">
                                                    <i class="bi bi-x-circle fs-5"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="app-card-footer d-flex justify-content-between align-items-center py-2 bg-light">
                        <small class="text-muted">Subtotal for <strong>@(stall?.Name ?? "Stall")</strong></small>
                        <span class="fw-bold text-primary fs-6">$@stallSubtotal.ToString("F2")</span>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="app-card shadow-sm sticky-top" style="top: 1.5rem;">
                <div class="app-card-header py-3">
                    <h5 class="fw-bold mb-0">Order Summary</h5>
                </div>

                <div class="app-card-body p-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Total Food Stalls:</span>
                        <span class="fw-semibold">@stallGroups.Count()</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Total Items:</span>
                        <span class="fw-semibold">@Model!.CartItems!.Sum(ci => ci.Quantity)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Estimated Tax & Fee:</span>
                        <span class="text-success fw-semibold">Free / Included</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold text-dark">Full Cart Total:</span>
                        <span class="fs-4 fw-bold text-primary">$@grandTotal.ToString("F2")</span>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary btn-lg">
                            <i class="bi bi-bag-check me-2"></i> Proceed to Checkout
                        </a>
                        <a asp-controller="FoodStall" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Add More Items
                        </a>
                    </div>
                </div>

                <div class="app-card-footer text-muted small py-3">
                    <i class="bi bi-bell-fill text-warning me-1"></i>
                    All relevant stall owners will receive instant notifications upon completing this order.
                </div>
            </div>
        </div>
    </div>
}
