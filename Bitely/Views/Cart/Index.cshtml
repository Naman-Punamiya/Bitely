@model Bitely.Models.Cart

@{
    ViewData["Title"] = "Shopping Cart";
    var hasItems = Model != null && Model.CartItems != null && Model.CartItems.Any();
    var grandTotal = hasItems ? Model!.CartItems!.Sum(ci => ci.UnitPrice * ci.Quantity) : 0m;
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cart3 text-primary me-2"></i>Shopping Cart</h2>
        <p class="text-muted mb-0">Review items in your cart and order in full</p>
    </div>
    @if (hasItems)
    {
        <form asp-controller="Cart" asp-action="ClearCart" method="post" onsubmit="return confirm('Are you sure you want to clear your entire cart?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash3 me-1"></i> Clear Cart
            </button>
        </form>
    }
</div>

@if (!hasItems)
{
    <div class="empty-state py-5 shadow-sm text-center">
        <div class="empty-state-icon fs-1 text-muted mb-2">
            <i class="bi bi-cart-x"></i>
        </div>
        <h5 class="empty-state-title">Your Cart is Empty</h5>
        <p class="empty-state-text small text-muted mb-3">
            Looks like you haven't added any dishes to your cart yet.
        </p>
        <a asp-controller="Menu" asp-action="Index" class="btn btn-sm btn-primary">
            <i class="bi bi-card-checklist me-1"></i> Browse Digital Menus
        </a>
    </div>
}
else
{
    var stallGroups = Model!.CartItems!
        .Where(ci => ci.MenuItem != null)
        .GroupBy(ci => ci.MenuItem!.FoodStall);

    <div class="row g-4">
        <div class="col-lg-8">
            @foreach (var group in stallGroups)
            {
                var stall = group.Key;
                var stallSubtotal = group.Sum(ci => ci.UnitPrice * ci.Quantity);

                <div class="app-card mb-4 border bg-white rounded-3 shadow-sm">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">
                                <i class="bi bi-shop text-primary me-1"></i>@(stall?.Name ?? "Food Stall")
                            </h5>
                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@(stall?.Location ?? "Food Court")</small>
                        </div>
                        <span class="badge bg-white text-dark border small">
                            @group.Count() dish@(group.Count() > 1 ? "es" : "")
                        </span>
                    </div>

                    <div class="table-responsive app-table">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="min-width: 160px;">Dish</th>
                                    <th>Price</th>
                                    <th style="min-width: 120px;">Quantity</th>
                                    <th class="text-end">Subtotal</th>
                                    <th class="text-end" style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    var itemSubtotal = item.UnitPrice * item.Quantity;
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@(item.MenuItem?.Name ?? "Item")</div>
                                            <span class="badge-category small">@(item.MenuItem?.Category ?? "General")</span>
                                        </td>
                                        <td class="text-muted">₹@item.UnitPrice.ToString("F2")</td>
                                        <td>
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control form-control-sm text-center px-1" style="width: 55px;" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" title="Update">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            ₹@itemSubtotal.ToString("F2")
                                        </td>
                                        <td class="text-end">
                                            <form asp-controller="Cart" asp-action="RemoveItem" method="post" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Remove">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 bg-light border-top rounded-bottom-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Stall Subtotal:</small>
                        <strong class="text-primary fs-6">₹@stallSubtotal.ToString("F2")</strong>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="app-card border bg-white rounded-3 shadow-sm p-4 sticky-top" style="top: 1.5rem;">
                <h5 class="fw-bold mb-3 text-dark">Order Summary</h5>

                <div class="d-flex justify-content-between mb-2 small text-muted">
                    <span>Total Food Stalls:</span>
                    <span class="fw-semibold text-dark">@stallGroups.Count()</span>
                </div>
                <div class="d-flex justify-content-between mb-3 small text-muted">
                    <span>Total Dishes:</span>
                    <span class="fw-semibold text-dark">@Model!.CartItems!.Sum(ci => ci.Quantity)</span>
                </div>

                <hr class="my-3" />

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="fw-bold text-dark fs-5">Grand Total:</span>
                    <span class="fw-bold text-primary fs-4">₹@grandTotal.ToString("F2")</span>
                </div>

                <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary btn-lg w-100 mb-2">
                    <i class="bi bi-credit-card-2-front me-1"></i> Proceed to Checkout
                </a>
                <a asp-controller="Menu" asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">
                    <i class="bi bi-plus-lg me-1"></i> Add More Items
                </a>
            </div>
        </div>
    </div>
}
