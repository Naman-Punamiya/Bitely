@model Bitely.Models.FoodStall

@{
    ViewData["Title"] = "Delete Food Stall";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="app-card border-danger shadow-sm">
            <div class="app-card-header bg-danger-subtle py-3">
                <h4 class="fw-bold text-danger mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Food Stall
                </h4>
            </div>

            <div class="app-card-body p-4">
                <p class="text-muted mb-4">
                    Are you sure you want to permanently delete this food stall? All associated menu items will also be removed. This action cannot be undone.
                </p>

                <div class="bg-light p-3 rounded-3 mb-4 border">
                    <h5 class="fw-bold text-dark mb-1">@Model.Name</h5>
                    <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i> @Model.Location</p>
                    <p class="text-secondary small mb-0">@Model.Description</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
