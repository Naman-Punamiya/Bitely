@model Bitely.Models.FoodStall
@using System.Security.Claims

@{
    ViewData["Title"] = $"{Model.Name} - Details";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isMyStall = currentUserId != null && Model.OwnerId == currentUserId;
    var isOwnerRole = User.IsInRole(Bitely.Models.Roles.FoodStallOwner);
    var cartDict = ViewBag.CartItemQuantities as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Food Stalls
    </a>

    <!-- Stall Header -->
    <div class="app-card border bg-white rounded-3 shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-2">
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h2 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-shop text-primary me-2"></i>@Model.Name
                    </h2>
                    @if (Model.IsOpen)
                    {
                        <span class="badge-open small py-0 px-2">
                            <i class="bi bi-check-circle-fill me-1"></i> Open
                        </span>
                    }
                    else
                    {
                        <span class="badge-closed small py-0 px-2">
                            <i class="bi bi-x-circle-fill me-1"></i> Closed
                        </span>
                    }
                </div>
                <p class="text-muted small mb-0">
                    <i class="bi bi-geo-alt text-primary me-1"></i> @Model.Location &nbsp;|&nbsp; 
                    <i class="bi bi-person text-secondary me-1"></i> Owner: <strong>@(Model.Owner?.Name ?? Model.Owner?.UserName ?? "Vendor")</strong>
                </p>
            </div>

            @if (isOwnerRole && isMyStall)
            {
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-pencil me-1"></i> Edit Stall
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </a>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-secondary small mt-2 mb-0">
                @Model.Description
            </p>
        }
    </div>

    <!-- Stall Menu Items -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Menu Items</h4>
            <p class="text-muted small mb-0">Dishes and beverages available at this counter</p>
        </div>
        @if (isOwnerRole && isMyStall)
        {
            <a asp-controller="Menu" asp-action="Create" asp-route-foodStallId="@Model.Id" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Menu Item
            </a>
        }
    </div>

    @if (Model.MenuItems != null && Model.MenuItems.Any())
    {
        <div class="table-responsive app-table shadow-sm mb-4">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Description</th>
                        <th>Availability</th>
                        <th class="text-end" style="min-width: 160px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.MenuItems)
                    {
                        var itemQty = cartDict.ContainsKey(item.Id) ? cartDict[item.Id] : 0;

                        <tr>
                            <td class="fw-semibold text-dark">@item.Name</td>
                            <td>
                                <span class="badge-category">@item.Category</span>
                            </td>
                            <td class="fw-bold text-primary">₹@item.Price.ToString("F2")</td>
                            <td class="text-muted small">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                            </td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge-open small py-0 px-2">
                                        <i class="bi bi-check me-1"></i> Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-closed small py-0 px-2">
                                        <i class="bi bi-x me-1"></i> Out of Stock
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (isOwnerRole && isMyStall)
                                {
                                    <div class="btn-group">
                                        <a asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary py-1" title="Edit Item">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-controller="Menu" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-1" title="Delete Item">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                }
                                else if (Model.IsOpen && item.IsAvailable)
                                {
                                    if (itemQty > 0)
                                    {
                                        <div class="d-inline-flex align-items-center border rounded bg-white shadow-sm overflow-hidden" style="height: 31px;">
                                            <form asp-controller="Cart" asp-action="UpdateItemQuantity" method="post" class="d-inline m-0">
                                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                                <input type="hidden" name="quantity" value="@(itemQty - 1)" />
                                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                                <button type="submit" class="btn btn-sm btn-light border-0 px-2 py-0 text-danger fw-bold h-100" title="Decrease">
                                                    <i class="bi bi-dash-lg"></i>
                                                </button>
                                            </form>
                                            <span class="px-2 fw-bold text-dark small" style="min-width: 24px; text-align: center;">@itemQty</span>
                                            <form asp-controller="Cart" asp-action="UpdateItemQuantity" method="post" class="d-inline m-0">
                                                <input type="hidden" name="menuItemId" value="@item.Id" />
                                                <input type="hidden" name="quantity" value="@(itemQty + 1)" />
                                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                                <button type="submit" class="btn btn-sm btn-light border-0 px-2 py-0 text-success fw-bold h-100" title="Increase">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline-flex align-items-center gap-1">
                                            <input type="hidden" name="menuItemId" value="@item.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary fw-semibold py-1 px-3 text-nowrap">
                                                <i class="bi bi-plus-lg me-1"></i> Add
                                            </button>
                                        </form>
                                    }
                                }
                                else if (!Model.IsOpen)
                                {
                                    <span class="badge bg-light text-muted border py-1 px-2">
                                        Stall Closed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-danger border py-1 px-2">
                                        Out of Stock
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state py-4 shadow-sm text-center">
            <div class="empty-state-icon fs-2 text-muted mb-2">
                <i class="bi bi-card-list"></i>
            </div>
            <h6 class="empty-state-title">No Menu Items Listed</h6>
            <p class="empty-state-text small text-muted mb-2">
                This food stall hasn't listed any dishes yet.
            </p>
            @if (isOwnerRole && isMyStall)
            {
                <a asp-controller="Menu" asp-action="Create" asp-route-foodStallId="@Model.Id" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add First Item
                </a>
            }
        </div>
    }
</div>
