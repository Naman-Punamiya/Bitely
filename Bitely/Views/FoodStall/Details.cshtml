@model Bitely.Models.FoodStall
@using System.Security.Claims

@{
    ViewData["Title"] = "Food Stall Details";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isMyStall = currentUserId != null && Model.OwnerId.ToString() == currentUserId;
    var isOwnerRole = User.IsInRole(Bitely.Models.Roles.FoodStallOwner);
}

<h2>@Model.Name</h2>

<div>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Location:</strong> @Model.Location</p>
    <p><strong>Status:</strong> @(Model.IsOpen ? "Open" : "Closed")</p>
    <p><strong>Owner:</strong> @(Model.Owner?.Name ?? Model.OwnerId.ToString())</p>
</div>

<h3>Menu Items</h3>

@if (isOwnerRole && isMyStall)
{
    <p>
        <a asp-controller="Menu" asp-action="Create" asp-route-foodStallId="@Model.Id">Add New Menu Item</a>
    </p>
}

@if (Model.MenuItems != null && Model.MenuItems.Any())
{
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Status</th>
                <th>Description</th>
                @if (isOwnerRole && isMyStall)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.MenuItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>$@item.Price</td>
                    <td>@(item.IsAvailable ? "Available" : "Unavailable")</td>
                    <td>@item.Description</td>
                    @if (isOwnerRole && isMyStall)
                    {
                        <td>
                            <a asp-controller="Menu" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-controller="Menu" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No menu items available for this stall.</p>
}

<br />
<p>
    <a asp-controller="Menu" asp-action="Index" asp-route-foodStallId="@Model.Id">View Full Menu Page</a> |
    <a asp-action="Index">Back to Stalls</a>
</p>
