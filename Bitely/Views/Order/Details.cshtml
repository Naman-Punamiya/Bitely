@model Bitely.Models.Order

@{
    ViewData["Title"] = $"Order Receipt - {Model.OrderNumber}";
    var isStallOwner = (bool)(ViewBag.IsStallOwner ?? false);

    var badgeClass = Model.Status switch
    {
        "Pending" => "badge-role",
        "Preparing" => "badge-open",
        "Ready" => "badge-open fw-bold",
        "Completed" => "bg-light text-muted border",
        "Cancelled" => "badge-closed",
        _ => "bg-light text-dark border"
    };
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="mb-3">
            @if (isStallOwner)
            {
                <a asp-action="StallOrders" asp-route-foodStallId="@Model.FoodStallId" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Stall Orders
                </a>
            }
            else
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to My Orders
                </a>
            }
        </div>

        <div class="app-card border bg-white rounded-3 shadow-sm mb-4">
            <div class="p-3 p-md-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 bg-light rounded-top-3">
                <div>
                    <h4 class="fw-bold mb-0 text-dark">Order @Model.OrderNumber</h4>
                    <small class="text-muted"><i class="bi bi-clock me-1"></i>Placed on @Model.CreatedAt.ToLocalTime().ToString("f")</small>
                </div>
                <span class="badge @badgeClass py-2 px-3 fs-6 rounded-pill">
                    Status: @Model.Status
                </span>
            </div>

            @if (isStallOwner)
            {
                <div class="p-3 bg-light border-bottom">
                    <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2 flex-wrap">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Order", new { id = Model.Id })" />
                        <label class="small fw-bold text-dark mb-0"><i class="bi bi-arrow-repeat me-1 text-primary"></i>Update Status:</label>
                        <select name="newStatus" class="form-select form-select-sm w-auto">
                            <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                            <option value="Preparing" selected="@(Model.Status == "Preparing")">Preparing</option>
                            <option value="Ready" selected="@(Model.Status == "Ready")">Ready for Pickup</option>
                            <option value="Completed" selected="@(Model.Status == "Completed")">Completed</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Save Status</button>
                    </form>
                </div>
            }

            <div class="p-3 p-md-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <span class="text-muted small d-block mb-1"><i class="bi bi-shop text-primary me-1"></i> Food Stall</span>
                            <h6 class="fw-bold text-dark mb-1">@(Model.FoodStall?.Name ?? "Food Stall")</h6>
                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i> @(Model.FoodStall?.Location ?? "Food Court")</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <span class="text-muted small d-block mb-1"><i class="bi bi-person text-primary me-1"></i> Customer</span>
                            <h6 class="fw-bold text-dark mb-1">@(Model.Customer?.Name ?? Model.Customer?.UserName ?? "Customer")</h6>
                            <small class="text-muted"><i class="bi bi-envelope me-1"></i> @(Model.Customer?.Email ?? "N/A")</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <span class="text-muted small d-block mb-1"><i class="bi bi-wallet2 text-primary me-1"></i> Payment</span>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                @if (Model.PaymentMethod == "Online")
                                {
                                    <span class="badge bg-primary"><i class="bi bi-credit-card me-1"></i> Online (Razorpay)</span>
                                    <span class="badge bg-success">@Model.PaymentStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-cash me-1"></i> Cash on Pickup</span>
                                    <span class="badge bg-warning text-dark">Pay at Counter</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.PaymentId))
                            {
                                <small class="text-muted font-monospace d-block text-truncate" title="@Model.PaymentId">
                                    ID: @Model.PaymentId
                                </small>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.CustomerNote))
                {
                    <div class="p-2 px-3 bg-light rounded-2 small mb-4 border text-muted">
                        <i class="bi bi-chat-left-text text-primary me-1"></i> <strong>Note:</strong> @Model.CustomerNote
                    </div>
                }

                <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-card-checklist text-primary me-1"></i>Ordered Items</h6>
                <div class="table-responsive app-table mb-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Item</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@item.ItemName</td>
                                    <td class="text-center text-muted">₹@item.UnitPrice.ToString("F2")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end fw-bold text-dark">₹@item.Subtotal.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light">
                            <tr>
                                <th colspan="3" class="text-end">Grand Total:</th>
                                <th class="text-end fs-5 text-primary fw-bold">₹@Model.TotalAmount.ToString("F2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
