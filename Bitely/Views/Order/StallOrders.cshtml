@model IEnumerable<Bitely.Models.Order>

@{
    ViewData["Title"] = "Incoming Stall Orders";
    var stalls = ViewBag.Stalls as List<Bitely.Models.FoodStall> ?? new List<Bitely.Models.FoodStall>();
    var selectedStallId = ViewBag.SelectedStallId as int?;
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-receipt text-primary me-2"></i>Incoming Stall Orders</h2>
        <p class="text-muted mb-0">Manage customer orders, prepare food, and update live preparation status</p>
    </div>

    @if (stalls.Count > 1)
    {
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small text-muted text-nowrap">Filter Stall:</label>
            <select name="foodStallId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- All My Stalls --</option>
                @foreach (var s in stalls)
                {
                    <option value="@s.Id" selected="@(selectedStallId == s.Id)">@s.Name</option>
                }
            </select>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon text-muted">
            <i class="bi bi-inbox"></i>
        </div>
        <div class="empty-state-title">No Orders Received Yet</div>
        <div class="empty-state-text">
            When customers place orders from your food stall, they will appear here with live notifications.
        </div>
        <a asp-controller="FoodStall" asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-shop me-1"></i> View My Stalls
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var order in Model)
        {
            var badgeClass = order.Status switch
            {
                "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning",
                "Preparing" => "bg-primary-subtle text-primary border border-primary",
                "Ready" => "bg-success-subtle text-success border border-success",
                "Completed" => "bg-secondary-subtle text-secondary border border-secondary",
                "Cancelled" => "bg-danger-subtle text-danger border border-danger",
                _ => "bg-light text-dark border"
            };

            <div class="col-md-6 col-lg-4">
                <div class="app-card shadow-sm h-100 d-flex flex-column">
                    <div class="app-card-header d-flex justify-content-between align-items-center py-2 px-3 bg-light">
                        <span class="fw-bold font-monospace text-dark">@order.OrderNumber</span>
                        <span class="badge @badgeClass py-1 px-2 rounded-pill small">
                            @order.Status
                        </span>
                    </div>

                    <div class="app-card-body p-3 flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong class="text-primary"><i class="bi bi-shop me-1"></i>@(order.FoodStall?.Name ?? "Stall")</strong>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@order.CreatedAt.ToLocalTime().ToString("h:mm tt")</small>
                        </div>

                        <div class="mb-2 small text-secondary">
                            <i class="bi bi-person me-1"></i> Customer: <strong>@(order.Customer?.Name ?? order.Customer?.UserName ?? "Customer")</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(order.CustomerNote))
                        {
                            <div class="alert alert-light py-1 px-2 mb-2 small border text-muted">
                                <i class="bi bi-chat-left-dots text-primary me-1"></i> "@order.CustomerNote"
                            </div>
                        }

                        <div class="border rounded-2 p-2 mb-3 bg-light small">
                            <div class="fw-bold text-dark mb-1">Items (@order.OrderItems.Sum(oi => oi.Quantity)):</div>
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in order.OrderItems)
                                {
                                    <li class="d-flex justify-content-between py-1 border-bottom border-light">
                                        <span>@item.Quantity &times; @item.ItemName</span>
                                        <span class="fw-semibold text-dark">$@item.Subtotal.ToString("F2")</span>
                                    </li>
                                }
                            </ul>
                            <div class="d-flex justify-content-between pt-1 fw-bold text-dark">
                                <span>Total:</span>
                                <span class="text-primary">$@order.TotalAmount.ToString("F2")</span>
                            </div>
                        </div>

                        <!-- Status Action Controls -->
                        <div class="d-flex gap-1 flex-wrap">
                            @if (order.Status == "Pending")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="newStatus" value="Preparing" />
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-fire me-1"></i> Start Preparing
                                    </button>
                                </form>
                            }
                            else if (order.Status == "Preparing")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="newStatus" value="Ready" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-bell-fill me-1"></i> Mark as Ready
                                    </button>
                                </form>
                            }
                            else if (order.Status == "Ready")
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="newStatus" value="Completed" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-check2-all me-1"></i> Mark Completed
                                    </button>
                                </form>
                            }

                            <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-light border ms-auto">
                                Details <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
