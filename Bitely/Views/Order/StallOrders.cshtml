@model IEnumerable<Bitely.Models.Order>

@{
    ViewData["Title"] = "Incoming Stall Orders";
    var stalls = ViewBag.Stalls as List<Bitely.Models.FoodStall> ?? new List<Bitely.Models.FoodStall>();
    var selectedStallId = ViewBag.SelectedStallId as int?;
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-receipt text-primary me-2"></i>Incoming Stall Orders</h2>
        <p class="text-muted mb-0">Manage customer orders and update preparation status in real time</p>
    </div>

    @if (stalls.Count > 1)
    {
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small text-muted text-nowrap">Filter Stall:</label>
            <select name="foodStallId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- All My Stalls --</option>
                @foreach (var s in stalls)
                {
                    <option value="@s.Id" selected="@(selectedStallId == s.Id)">@s.Name</option>
                }
            </select>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state py-5 shadow-sm text-center">
        <div class="empty-state-icon fs-1 text-muted mb-2">
            <i class="bi bi-inbox"></i>
        </div>
        <h5 class="empty-state-title">No Orders Received Yet</h5>
        <p class="empty-state-text small text-muted mb-3">
            When customers place orders from your food stall, they will appear here.
        </p>
        <a asp-controller="FoodStall" asp-action="Index" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-shop me-1"></i> View My Stalls
        </a>
    </div>
}
else
{
    <div class="row g-3 g-md-4">
        @foreach (var order in Model)
        {
            var badgeClass = order.Status switch
            {
                "Pending" => "badge-role",
                "Preparing" => "badge-open",
                "Ready" => "badge-open fw-bold",
                "Completed" => "bg-light text-muted border",
                "Cancelled" => "badge-closed",
                _ => "bg-light text-dark border"
            };

            <div class="col-md-6 col-lg-4">
                <div class="app-card h-100 d-flex flex-column border bg-white rounded-3 shadow-none hover-shadow transition">
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light rounded-top-3">
                        <span class="fw-bold font-monospace text-dark">@order.OrderNumber</span>
                        <span class="badge @badgeClass py-1 px-2 rounded-pill small">
                            @order.Status
                        </span>
                    </div>

                    <div class="p-3 flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong class="text-primary"><i class="bi bi-shop me-1"></i>@(order.FoodStall?.Name ?? "Stall")</strong>
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@order.CreatedAt.ToLocalTime().ToString("h:mm tt")</small>
                        </div>

                        <div class="mb-2 small text-secondary">
                            <i class="bi bi-person me-1"></i> Customer: <strong>@(order.Customer?.Name ?? order.Customer?.UserName ?? "Customer")</strong>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(order.CustomerNote))
                        {
                            <div class="p-2 bg-light rounded small border text-muted mb-2">
                                <i class="bi bi-chat-left-dots text-primary me-1"></i> "@order.CustomerNote"
                            </div>
                        }

                        <div class="border rounded-2 p-2 mb-3 bg-light small">
                            <div class="fw-bold text-dark mb-1">Items (@order.OrderItems.Sum(oi => oi.Quantity)):</div>
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in order.OrderItems)
                                {
                                    <li class="d-flex justify-content-between py-1 border-bottom border-light">
                                        <span>@item.Quantity &times; @item.ItemName</span>
                                        <span class="fw-semibold text-dark">₹@item.Subtotal.ToString("F2")</span>
                                    </li>
                                }
                            </ul>
                            <div class="d-flex justify-content-between pt-1 fw-bold text-dark">
                                <span>Total:</span>
                                <span class="text-primary">₹@order.TotalAmount.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between pt-1 small">
                                <span class="text-muted">Payment:</span>
                                @if (order.PaymentMethod == "Online")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        <i class="bi bi-credit-card me-1"></i> Paid Online
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-cash me-1"></i> Cash on Pickup
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Status Update Actions -->
                        <form asp-action="UpdateStatus" method="post" class="mt-auto">
                            <input type="hidden" name="id" value="@order.Id" />
                            <label class="form-label small fw-semibold text-muted mb-1">Change Status:</label>
                            <div class="input-group input-group-sm">
                                <select name="newStatus" class="form-select">
                                    <option value="Pending" selected="@(order.Status == "Pending")">Pending</option>
                                    <option value="Preparing" selected="@(order.Status == "Preparing")">Preparing</option>
                                    <option value="Ready" selected="@(order.Status == "Ready")">Ready for Pickup</option>
                                    <option value="Completed" selected="@(order.Status == "Completed")">Completed</option>
                                    <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled</option>
                                </select>
                                <button type="submit" class="btn btn-primary">Update</button>
                            </div>
                        </form>
                    </div>

                    <div class="p-2 px-3 bg-light border-top rounded-bottom-3 text-end">
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-link text-decoration-none p-0">
                            View Receipt <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
