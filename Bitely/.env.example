# PostgreSQL Configuration
# Local Development:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bitely_db
# DB_USER=postgres
# DB_PASSWORD=postgres

# Cloud / Supabase Configuration:
# Note: For Supabase Pooler with EF Core migrations, use port 5432 (Session mode)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitely_db
DB_USER=postgres
DB_SSLMODE=Prefer

# Razorpay Payment Gateway (Test Mode)
# Replace with your Razorpay Test Key ID & Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
